# JWMP 平台 API Key（控制台 > API密钥）
JWMP_API_KEY=sk-xxxxxxxx

# 网关地址（一般不用改）
JWMP_BASE_URL=https://kwjm.com

# 本地服务端口
PORT=3780

# 数据目录（历史 + 图片 + 模型配置）。本地可省略，默认 ./data
# Render 挂载持久盘后请设为挂载点，例如：
# DATA_DIR=/var/data

# ---- Cloudflare R2（推荐，免费额度 + 重启不丢数据）----
# 四个都填齐后启用 R2；不填则用本地磁盘
# R2_ACCOUNT_ID=你的 Cloudflare Account ID
# R2_ACCESS_KEY_ID=R2 API Token 的 Access Key ID
# R2_SECRET_ACCESS_KEY=R2 API Token 的 Secret
# R2_BUCKET=banana-data
# 可选自定义 endpoint（一般不用）：
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
